+// PRIVATE BRIDGE: read and clear one GUI frame's Morph-only gestures.
+extern "C" void sdk_morph_aux_events_take(opxy::u32 track, opxy::u32* clicks, opxy::i32* turns) {
+    if (clicks) *clicks = 0u;
